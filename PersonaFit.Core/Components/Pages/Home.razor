@page "/"

<h1>Personafit</h1>

<button @onclick="NavigateToLogin">Login</button>

<AuthorizeView>
    <Authorizing>Checking Auth State</Authorizing>
    <NotAuthorized>Not Authorized</NotAuthorized>
    <Authorized>
        User is Authorized
        Name: @context.User.Identity.Name
    </Authorized>
</AuthorizeView>

